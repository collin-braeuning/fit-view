// Copy this file to `Secrets.xcconfig` (untracked — see .gitignore) and fill
// in real values once a Polar client is registered at
// https://admin.polaraccesslink.com.
//
// Polar's token exchange is HTTP Basic (client_id:client_secret) with no
// PKCE support, so the secret has to ship inside the app binary — there is
// no way around embedding it in a distributed build. Acceptable for a
// personal app; a genuine leak for a public App Store release (tracked as a
// GitHub issue). Keeping it in this untracked xcconfig, rather than in
// source, at least keeps it out of git history.
//
// Until this file exists with real values, `Secrets.xcconfig` (a copy of
// this template) ships so `xcodegen generate`/Xcode builds still succeed —
// PolarConfiguration.isConfigured recognizes these placeholders and reports
// "not configured" instead of attempting a doomed OAuth round-trip.
POLAR_CLIENT_ID = YOUR_POLAR_CLIENT_ID
POLAR_CLIENT_SECRET = YOUR_POLAR_CLIENT_SECRET
